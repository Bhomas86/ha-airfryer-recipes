+def _require_sync_report(fryer: FryerData, *, allow_prepared: bool) -> None:
+    """Fail closed on incomplete, unknown or stale reports before writing."""
+    from datetime import datetime, timezone
+
+    if fryer.online is not True or getattr(fryer, "last_error", None):
+        raise SyncBlocked("Kein fehlerfreier Online-Bericht. Nichts gesendet.", "zustand_unbekannt")
+    reported = getattr(fryer, "last_report", None)
+    if (not isinstance(reported, datetime) or reported.tzinfo is None
+            or not 0 <= (datetime.now(timezone.utc) - reported).total_seconds() <= 15):
+        raise SyncBlocked("Kein frischer Bericht. Nichts gesendet.", "meldung_veraltet")
+    state = getattr(fryer, "state", None)
+    zones = getattr(state, "zones", None)
+    if (not isinstance(zones, dict) or len(zones) != 2
+            or any(type(z) is not int for z in zones) or set(zones) != {1, 2}
+            or getattr(state, "active", None) is not False):
+        raise SyncBlocked("Beide inaktiven Faecher muessen gemeldet sein. Nichts gesendet.", "zustand_unbekannt")
+    allowed = {"aus", "bereit"} | (PREPARED if allow_prepared else set())
+    if any(getattr(z, "status", None) not in allowed
+           or getattr(z, "active", None) is not False for z in zones.values()):
+        raise SyncBlocked("Ein Fach ist nicht sicher inaktiv. Nichts gesendet.", "zustand_unbekannt")
+
+
